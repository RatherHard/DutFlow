# Arch client config: copy to ~/.config/dutflow/.env and chmod 600.
# This is sourced by Bash; only use trusted files. Quote shell special characters.
DUTFLOW_URL='https://rendezvous.example.com'
DUTFLOW_TOKEN='REPLACE_WITH_SERVER_TOKEN'
DUTFLOW_SSH_USER='WINDOWS_USERNAME'
DUTFLOW_SSH_KEY="$HOME/.ssh/dutflow_windows"
