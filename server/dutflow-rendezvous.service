[Unit]
Description=dutflow LAN rendezvous
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dutflow
Group=dutflow
EnvironmentFile=/etc/dutflow/dutflow.env
ExecStart=/usr/bin/python3 /opt/dutflow/dutflow-rendezvous.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dutflow

[Install]
WantedBy=multi-user.target
